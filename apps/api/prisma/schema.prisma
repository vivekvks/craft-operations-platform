
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncidentSeverity {
  Critical
  High
  Medium
  Low
}

enum IncidentStatus {
  Investigating
  Monitoring
  Resolved
}

model Incident {
  id        String           @id
  title     String
  severity  IncidentSeverity
  status    IncidentStatus   @default(Investigating)
  service   String
  team      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("incidents")
}
